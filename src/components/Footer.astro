---
import { SITE_AUTHOR, SOCIAL } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<p>© {year} {SITE_AUTHOR}</p>
	<div class="links">
		<a href={SOCIAL.github}>GitHub</a>
		<a href={SOCIAL.email}>Email</a>
	</div>
</footer>

<style>
	footer {
		width: min(720px, calc(100% - 2rem));
		margin: 0 auto 2rem;
		padding-top: 1.1rem;
		border-top: 1px solid var(--line);
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--muted);
		font-size: 0.8rem;
		font-family: var(--font-mono), ui-monospace, monospace;
	}
	footer p {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1rem;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--ink);
	}
</style>
